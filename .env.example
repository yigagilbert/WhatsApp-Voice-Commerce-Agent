# =============================================================================
# Katale AI — environment configuration
# Copy to `.env` at the repository root:  cp .env.example .env
# All apps load this single root file. NEVER commit real credentials.
# =============================================================================

NODE_ENV=development
# trace | debug | info | warn | error
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
# docker-compose exposes Postgres on 5433 to avoid clashing with a local install.
DATABASE_URL=postgresql://vca:vca@localhost:5433/vca?schema=public

# --- API (apps/api) ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
# Public base URL of the API. PayPal return/cancel URLs are built from it.
# For PayPal webhooks in local dev, expose the API with a tunnel (ngrok, cloudflared).
API_PUBLIC_URL=http://localhost:4000
# Bearer token the dashboard (server-side) uses to call the API. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_AUTH_TOKEN=change-me-dashboard-token
# Shared secret between the WhatsApp worker and the API (both directions).
INTERNAL_SERVICE_TOKEN=change-me-internal-token
CORS_ORIGINS=http://localhost:3000
# Requests per minute per client IP.
RATE_LIMIT_MAX=120

# --- AI / LLM ------------------------------------------------------------------
# Only "openai-compatible" is implemented today ("openai_compatible" also accepted).
# Works with OpenAI, OpenRouter, Groq, Together, vLLM, Ollama's /v1 endpoint, ...
# The model MUST support native tool calling (`tools` parameter). Check with: pnpm ai:check
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=30000

# --- Speech --------------------------------------------------------------------
# Voice notes: true = transcribe and handle like text; false = reply "Voice messages are coming soon".
VOICE_NOTES_ENABLED=false
# Longest voice note processed (checked before any speech-to-text call).
VOICE_MAX_DURATION_SECONDS=60
# Below this ASR confidence (0..1) Katale AI reads the transcript back ("I heard: …") before acting.
VOICE_MIN_CONFIDENCE=0.5
# Sunbird AI (Luganda speech-to-text + translation). When set, voice notes Whisper doesn't hear as
# English are transcribed by Sunbird as Luganda.
SUNBIRD_API_URL=https://api.sunbird.ai
# EXPERIMENTAL (frozen): Luganda voice via Sunbird AI. English is the supported voice language;
# with this off, voice notes in other languages are read back for a typed YES.
VOICE_EXPERIMENTAL_LUGANDA=false
SUNBIRD_API_KEY=
# Spoken languages to translate to English before the agent (e.g. "lg"); empty = LLM reads them directly.
VOICE_TRANSLATE_LANGUAGES=
# Speech-to-text. "openai-compatible" uses the /audio/transcriptions endpoint.
# "none" disables voice notes (the agent replies that audio is unsupported).
STT_PROVIDER=openai-compatible
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
# Translation of non-English transcripts into the agent's working language.
# "none" keeps the transcript as-is; "sunbird" uses Sunbird AI translation.
TRANSLATION_PROVIDER=none
# "ffmpeg" converts voice notes to 16 kHz mono WAV before ASR; "none" passes through.
AUDIO_NORMALIZER=none
FFMPEG_PATH=ffmpeg
# Max accepted inbound media size in bytes (default 10 MB).
MEDIA_MAX_BYTES=10485760

# --- PayPal (Sandbox) ----------------------------------------------------------
# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox
# Verify with: pnpm paypal:check   (full guide: docs/development/real-services.md)
# Buyer return/cancel URLs are derived from API_PUBLIC_URL:
#   ${API_PUBLIC_URL}/api/paypal/return   (captures the payment)
#   ${API_PUBLIC_URL}/api/paypal/cancel
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the PayPal developer dashboard (needed for signature verification).
# Optional for a local demo (the return URL captures payments); required once deployed.
# The webhook URL is ${API_PUBLIC_URL}/api/paypal/webhooks and must be public (use a tunnel).
PAYPAL_WEBHOOK_ID=
PAYPAL_BRAND_NAME=Katale AI
# Development escape hatch ONLY. Ignored unless NODE_ENV=development.
PAYPAL_WEBHOOK_SKIP_VERIFICATION=false

# --- Commerce policy -----------------------------------------------------------
DEFAULT_CURRENCY=USD
# How long a merchant has to confirm a sensitive action.
CONFIRMATION_TTL_SECONDS=600
# Guardrail: payment requests above this amount (major units) are refused.
MAX_PAYMENT_REQUEST_AMOUNT=10000
# Country used to read local admin numbers ("0772 123456" → +256772123456). ISO-3166 alpha-2.
DEFAULT_PHONE_REGION=UG
# Proactive WhatsApp business reports (schedule them in the dashboard → Reports). Run the
# scheduler in exactly one API process; set false on any extra replicas.
REPORT_SCHEDULER_ENABLED=true
# Numbers that aren't active admins get one generic welcome per this many hours (no data, no AI).
UNAUTHORIZED_REPLY_COOLDOWN_HOURS=24
# Re-check open PayPal links in the background (recovers payments whose webhook was lost).
PAYMENT_RECONCILIATION_ENABLED=true
# Customer shopping on WhatsApp (server-wide switch; each shop number must also enable it in the
# dashboard → WhatsApp). Off: every non-admin gets the generic welcome.
CUSTOMER_COMMERCE_ENABLED=false

# --- WhatsApp worker (apps/whatsapp) ------------------------------------------
# Where the worker forwards normalized inbound messages.
WHATSAPP_API_BASE_URL=http://localhost:4000
# LocalAuth session storage (git-ignored). Relative paths resolve from the repo root.
WHATSAPP_SESSION_DIR=.data/whatsapp-session
WHATSAPP_CLIENT_ID=katale-dev
WHATSAPP_HEADLESS=true
# Optional: use an existing Chrome/Chromium instead of Puppeteer's bundled one.
WHATSAPP_CHROME_PATH=
# The worker's small internal HTTP gateway used by the API for outbound messages.
WHATSAPP_GATEWAY_PORT=4100
# Bind address for the gateway (use 0.0.0.0 only inside Docker networks).
WHATSAPP_GATEWAY_HOST=127.0.0.1
# Print the pairing QR in the logs (the dashboard's WhatsApp page always shows it to signed-in users).
WHATSAPP_PRINT_QR=true
# Decline incoming WhatsApp calls and suggest a voice note (whatsapp-web.js has no call audio).
WHATSAPP_REJECT_CALLS=true
WHATSAPP_GATEWAY_URL=http://localhost:4100

# --- Seed data -------------------------------------------------------------------
# WhatsApp ID allowed to operate the demo merchant, e.g. 15550001111@c.us
# (country code + number, no "+"). Leave empty to seed without an operator.
SEED_MERCHANT_WHATSAPP_ID=

# --- Web dashboard (apps/web) --------------------------------------------------
# Server-side only. The browser never sees API_AUTH_TOKEN.
# Dashboard login (single operator account). Without DASHBOARD_PASSWORD every login is refused.
# Use a long random password in production:  openssl rand -base64 24
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_HOURS=12
# Optional AG Studio licence key for the Analytics page. Without it AG Studio runs with all
# features unlocked but shows a watermark and a console notice (trial key: info@ag-grid.com).
AG_STUDIO_LICENSE_KEY=
API_BASE_URL=http://localhost:4000
