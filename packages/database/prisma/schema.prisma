// Voice Commerce Agent — database schema.
//
// Conventions
// - All monetary amounts are stored as integers in the currency's MINOR unit
//   (e.g. cents) in `*Minor` columns, together with an ISO-4217 `currency`.
//   Never floats. Arithmetic lives in @vca/commerce (deterministic code, not the LLM).
// - The database is the source of truth. The AI layer only reads it through tools.
// - Channel names are stored as lowercase strings ("whatsapp", "web", ...) so new
//   channels need no migration.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Merchants & access
// ---------------------------------------------------------------------------

model Merchant {
  id                String   @id @default(cuid())
  businessName      String
  ownerName         String
  ownerEmail        String?
  /// ISO-4217 code, e.g. "USD". Must be a PayPal-supported currency to take payments.
  preferredCurrency String   @default("USD")
  /// BCP-47 language tag, e.g. "en", "lg" (Luganda).
  preferredLanguage String   @default("en")
  /// IANA timezone used for "today" / "this week" analytics.
  timezone          String   @default("Africa/Kampala")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  operators        MerchantOperator[]
  customers        Customer[]
  dashboardLayouts DashboardLayout[]
  products         Product[]
  orders           Order[]
  payments         Payment[]
  conversations    Conversation[]
  confirmations    ActionConfirmation[]
  auditEvents      AuditEvent[]
  shipments        Shipment[]
  disputes         Dispute[]
  stockMovements   StockMovement[]
  reportSchedule   ReportSchedule?
  reportRuns       ReportRun[]
  whatsappAccounts WhatsAppAccount[]
  dashboardUsers   DashboardUser[]
  statusAdSettings StatusAdSettings?
  statusAds        StatusAd[]
  priceOffers      PriceOffer[]
  storefront       Storefront?
  cartTransfers    CartTransfer[]

  /// Bundle discount: buying at least this many different products open to bargaining together
  /// takes `bundlePercentOff` off each of them (null = no bundle discount).
  bundleMinItems   Int?
  bundlePercentOff Int?

  @@map("merchants")
}

enum OrderPlacer {
  MERCHANT
  CUSTOMER
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum PaymentLinkMode {
  /// Customer confirms → PayPal link sent at once (prices from the catalog only).
  AUTO
  /// Customer confirms → an admin approves → link sent.
  APPROVAL
}

/// A WhatsApp bot number and the ONE merchant it serves. Customers who message this number are
/// that merchant's customers; admins of other merchants are treated as customers here.
model WhatsAppAccount {
  id                      String          @id @default(cuid())
  merchantId              String
  /// The bot's own WhatsApp ID, e.g. "256700000000@c.us".
  wid                     String          @unique
  /// Customer commerce on this number (also needs CUSTOMER_COMMERCE_ENABLED).
  customerCommerceEnabled Boolean         @default(false)
  paymentLinkMode         PaymentLinkMode @default(AUTO)
  /// Automated replies pause this long after a customer asks for a person.
  handoffHours            Int             @default(12)
  /// Merchant-written answers for customers: hours, delivery, returns, contact.
  shopInfo                String?
  /// Customer checkout: delivery (with a flat fee in the merchant's currency) and/or pickup.
  deliveryEnabled         Boolean         @default(true)
  deliveryFeeMinor        Int             @default(0)
  pickupEnabled           Boolean         @default(false)
  /// Where and when to collect (shown to customers who choose pickup).
  pickupInfo              String?
  /// Owner opt-in: the public homepage's "Chat on WhatsApp" link and QR code use this number
  /// (only while it is the linked bot and customer shopping is on).
  listedOnHomepage        Boolean         @default(false)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("whatsapp_accounts")
}

/// A channel identity (e.g. a WhatsApp ID) that is allowed to operate a merchant.
/// Messages from unknown identities are never turned into commerce actions.
model MerchantOperator {
  id             String       @id @default(cuid())
  merchantId     String
  name           String
  channel        String
  /// The chat ID messages arrive from / are sent to (e.g. 256700000000@c.us, …@lid, "dashboard").
  externalId     String
  role           OperatorRole @default(OWNER)
  /// WhatsApp admins: phone in E.164 (+256700000000). Senders are matched by ID, linked ID or phone.
  phone          String?
  /// WhatsApp linked ID (…@lid) learned when this admin first messages the bot.
  whatsappLid    String?
  /// Only active admins can operate the bot or receive business information.
  active         Boolean      @default(true)
  receiveReports Boolean      @default(true)
  receiveAlerts  Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  merchant   Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  deliveries ReportDelivery[]

  @@unique([channel, externalId])
  @@unique([channel, phone])
  @@index([channel, whatsappLid])
  @@index([merchantId])
  @@map("merchant_operators")
}

/// A person who signs in to the dashboard (one account each; replaces the shared login).
/// While no account exists, the bootstrap login from DASHBOARD_USERNAME/PASSWORD is accepted so the
/// first owner can be created; it stops working as soon as one account exists.
model DashboardUser {
  id                String       @id @default(cuid())
  merchantId        String
  /// Sign-in name, stored lower-case; unique across the installation.
  username          String       @unique
  name              String
  role              OperatorRole @default(STAFF)
  /// scrypt hash (`scrypt$N$r$p$salt$hash`); the password itself is never stored or logged.
  passwordHash      String
  active            Boolean      @default(true)
  /// Bumped on password change, deactivation and "sign out everywhere": older sessions stop working.
  sessionVersion    Int          @default(1)
  failedLogins      Int          @default(0)
  /// Too many wrong passwords: no sign-in for this account until then.
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("dashboard_users")
}

enum OperatorRole {
  OWNER
  STAFF
}

// ---------------------------------------------------------------------------
// Catalog & customers
// ---------------------------------------------------------------------------

model Customer {
  id                String         @id @default(cuid())
  merchantId        String
  name              String
  phone             String?
  /// Channel identity used to message the customer (e.g. "15550001111@c.us" or "…@lid").
  whatsappId        String?
  /// Linked ID (@lid) when WhatsApp hides the phone number.
  whatsappLid       String?
  /// E.164 phone as resolved by WhatsApp itself (trusted for linking, unlike typed numbers).
  whatsappPhone     String?
  source            CustomerSource @default(MERCHANT)
  email             String?
  /// ISO-3166 alpha-2 country code.
  country           String?
  preferredCurrency String?
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders        Order[]
  conversations Conversation[]

  @@unique([merchantId, whatsappId])
  @@unique([merchantId, whatsappLid])
  @@index([merchantId, name])
  @@map("customers")
}

enum CustomerSource {
  /// Created by the merchant (dashboard, chat with the agent).
  MERCHANT
  /// Created when the customer first messaged the shop's WhatsApp bot.
  WHATSAPP
}

model Product {
  id                 String    @id @default(cuid())
  merchantId         String
  name               String
  description        String?
  sku                String?
  unitPriceMinor     Int
  currency           String
  /// null = inventory not tracked for this product.
  stockQuantity      Int?
  /// Alert when stock falls to or below this level (null = no low-stock alerts).
  reorderLevel       Int?
  /// Set when a low-stock alert was sent; cleared when stock is back above the reorder level.
  lowStockAlertedAt  DateTime?
  active             Boolean   @default(true)
  /// Shown to customers on WhatsApp and on the public storefront.
  visibleToCustomers Boolean   @default(true)
  /// Free-text storefront category, e.g. "Baskets" (null = uncategorised).
  category           String?
  /// Customers may bargain on WhatsApp (false = fixed price). Requires minPriceMinor.
  bargainingEnabled  Boolean   @default(false)
  /// Lowest unit price the merchant accepts. Never shown to customers.
  minPriceMinor      Int?
  /// Quantity discounts: [{ minQuantity, percentOff }], at most 3 tiers (see @vca/commerce bargaining).
  quantityDiscounts  Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  merchant       Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  image          ProductImage?
  statusAds      StatusAd[]
  priceOffers    PriceOffer[]

  @@unique([merchantId, sku])
  @@index([merchantId, name])
  @@index([merchantId, category])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Orders & payments
// ---------------------------------------------------------------------------

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

/// Why an order was cancelled.
enum OrderCancelReason {
  /// Not paid by its payment due time (UNPAID_ORDER_EXPIRY_HOURS).
  PAYMENT_EXPIRED
  /// Cancelled by the merchant (dashboard).
  MERCHANT
  /// Cancelled by the customer (WhatsApp "cancel ORD-…").
  CUSTOMER
}

/// Why a paid order needs a person to look at it before it is fulfilled.
enum OrderAttention {
  /// Payment completed after the order was cancelled: it was reinstated, but its stock may have
  /// been sold to someone else meanwhile. Shipping is blocked until an owner marks it reviewed.
  PAID_AFTER_CANCEL
  /// A second payment arrived for an already-paid order (old payment link): refund the extra.
  DUPLICATE_PAYMENT
}

enum FulfillmentStatus {
  NOT_SHIPPED
  SHIPPED
}

enum OrderInputMode {
  TEXT
  VOICE
}

model Order {
  id                  String             @id @default(cuid())
  /// Short human-friendly reference shown in chat, e.g. "ORD-7K2M9Q".
  reference           String             @unique
  merchantId          String
  customerId          String
  conversationId      String?
  status              OrderStatus        @default(DRAFT)
  currency            String
  subtotalMinor       Int
  shippingMinor       Int                @default(0)
  taxMinor            Int                @default(0)
  totalMinor          Int
  notes               String?
  /// Channel the order originated from ("whatsapp", "web", "api").
  /// Channel the order came from: "whatsapp" or "web" (Agent Console).
  source              String
  /// How the merchant asked: typed text or a transcribed voice note.
  inputMode           OrderInputMode     @default(TEXT)
  /// Fulfillment is a separate dimension from payment: PAID + NOT_SHIPPED = waiting to ship.
  fulfillmentStatus   FulfillmentStatus  @default(NOT_SHIPPED)
  /// Who created the order: the merchant (dashboard/agent) or a customer shopping on WhatsApp.
  placedBy            OrderPlacer        @default(MERCHANT)
  /// Customer orders: set when the customer replied ORDER (null = still a cart).
  customerConfirmedAt DateTime?
  /// Customer carts expire (48 h after the last change) if not ordered.
  expiresAt           DateTime?
  deliveryMethod      DeliveryMethod?
  deliveryAddress     String?
  /// Name for the order as given by the customer at checkout.
  contactName         String?
  /// Unpaid orders (awaiting payment, or placed by a customer and awaiting the owner's approval)
  /// are cancelled after this time and their reserved stock is released.
  paymentDueAt        DateTime?
  cancelledAt         DateTime?
  cancelReason        OrderCancelReason?
  /// Sum of completed refunds (minor units). Equal to totalMinor once fully refunded.
  refundedMinor       Int                @default(0)
  /// Set when the order needs review (see OrderAttention); cleared when an owner marks it reviewed.
  attention           OrderAttention?
  attentionAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     Payment[]
  shipments    Shipment[]
  disputes     Dispute[]
  refunds      Refund[]

  @@index([status, paymentDueAt])
  @@index([merchantId, createdAt])
  @@index([merchantId, status])
  @@index([merchantId, customerId, status])
  @@map("orders")
}

model OrderItem {
  id                 String      @id @default(cuid())
  orderId            String
  productId          String?
  description        String
  quantity           Int
  unitPriceMinor     Int
  lineTotalMinor     Int
  position           Int         @default(0)
  /// The catalog price when the line is discounted (null = sold at the regular price).
  listUnitPriceMinor Int?
  /// How unitPriceMinor was set: regular price, a quantity or bundle discount, or a bargain.
  pricing            LinePricing @default(LIST)
  /// The accepted offer behind a NEGOTIATED price.
  priceOfferId       String?

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  priceOffer PriceOffer? @relation(fields: [priceOfferId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

enum LinePricing {
  LIST
  QUANTITY
  BUNDLE
  NEGOTIATED
}

enum PriceOfferStatus {
  /// Offered by the shop; the customer hasn't answered yet.
  OPEN
  /// Agreed: applies to the bound cart (orderId) until expiresAt.
  ACCEPTED
  /// The customer declined it or went back to the regular price.
  REJECTED
  /// Replaced by a newer offer for the same product.
  SUPERSEDED
}

/**
 * One step of a WhatsApp bargain: a unit price the shop offered (or a customer price it agreed
 * to). Prices are computed by @vca/commerce negotiate() within the merchant's minimum; the AI
 * only relays them. An accepted offer is bound to one customer's cart and expires.
 */
model PriceOffer {
  id                String           @id @default(cuid())
  merchantId        String
  customerId        String
  productId         String
  /// The cart the offer is applied to (set when accepted).
  orderId           String?
  quantity          Int
  currency          String
  /// Regular unit price when the offer was made.
  listUnitMinor     Int
  /// The agreed / offered unit price.
  offerUnitMinor    Int
  /// What the customer proposed (per unit), if they named a price.
  customerUnitMinor Int?
  /// Shop counter-offer number (1–3) within the bargaining window.
  round             Int
  status            PriceOfferStatus @default(OPEN)
  expiresAt         DateTime
  acceptedAt        DateTime?
  createdAt         DateTime         @default(now())

  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([merchantId, customerId, productId, createdAt])
  @@index([orderId, status])
  @@map("price_offers")
}

enum PaymentProvider {
  PAYPAL
}

enum PaymentKind {
  /// PayPal Orders v2 checkout (approve link).
  CHECKOUT_ORDER
  /// PayPal Invoicing v2.
  INVOICE
}

enum PaymentStatus {
  /// Request created at the provider; waiting for the buyer.
  CREATED
  /// Buyer approved; capture pending.
  APPROVED
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

model Payment {
  id                String          @id @default(cuid())
  merchantId        String
  orderId           String
  provider          PaymentProvider
  kind              PaymentKind
  /// Provider-side ID (PayPal order ID or invoice ID).
  externalId        String?
  /// Provider capture/transaction ID once money moved.
  captureId         String?
  status            PaymentStatus   @default(CREATED)
  /// Last status reported by the provider (e.g. PayPal "PAYER_ACTION_REQUIRED", "COMPLETED").
  providerStatus    String?
  amountMinor       Int
  currency          String
  checkoutUrl       String?
  /// Sent as PayPal-Request-Id so retries never create duplicate requests.
  idempotencyKey    String          @unique
  /// Trace ID of the transaction (correlation ID of the request that drafted the order).
  correlationId     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  completedAt       DateTime?
  /// Payment reminders sent to the customer for this link (merchant-approved, rate limited).
  reminderCount     Int             @default(0)
  lastReminderAt    DateTime?
  /// Last time the reconciler asked PayPal about this payment (throttles background checks).
  providerCheckedAt DateTime?
  /// Sum of completed refunds/reversals (minor units). Partial: status stays COMPLETED;
  /// full: status REFUNDED. Net revenue = amountMinor - refundedMinor.
  refundedMinor     Int             @default(0)
  /// A second payment for an order that was already paid (e.g. through an older link). Its refunds
  /// don't refund the order itself.
  duplicate         Boolean         @default(false)

  merchant  Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipments Shipment[]
  disputes  Dispute[]
  refunds   Refund[]

  @@unique([provider, externalId])
  @@index([merchantId, status])
  @@index([merchantId, completedAt])
  @@map("payments")
}

/// A refund or reversal of a captured payment, as reported by the provider (one row per provider
/// refund ID, so webhook redeliveries and reconciliation never count a refund twice). Katale
/// never initiates refunds; it records them and keeps the order and analytics consistent.
model Refund {
  id          String          @id @default(cuid())
  merchantId  String
  orderId     String
  paymentId   String
  provider    PaymentProvider
  /// Provider refund ID (PayPal refund ID, or "reversal:<captureId>" for a reversal).
  externalId  String
  amountMinor Int
  currency    String
  /// Provider status (e.g. COMPLETED, PENDING). Only COMPLETED refunds count towards totals.
  status      String
  /// "refund" or "reversal".
  kind        String          @default("refund")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([merchantId, createdAt])
  @@index([paymentId])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// Conversations
// ---------------------------------------------------------------------------

model Conversation {
  id             String               @id @default(cuid())
  merchantId     String
  customerId     String?
  channel        String
  externalChatId String
  /// Session metadata (e.g. last referenced order) — never financial truth.
  context        Json?
  /// Who the bot talks to in this chat: a merchant admin or a customer.
  audience       ConversationAudience @default(ADMIN)
  /// Customer asked for a person: automated replies paused until then (or an admin resumes).
  handoffUntil   DateTime?
  lastMessageAt  DateTime             @default(now())
  createdAt      DateTime             @default(now())

  merchant      Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages      Message[]
  orders        Order[]
  confirmations ActionConfirmation[]

  @@unique([merchantId, channel, externalChatId])
  @@map("conversations")
}

enum ConversationAudience {
  ADMIN
  CUSTOMER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  AUDIO
  /// Image, document, sticker, ... — recorded but not processed yet.
  UNSUPPORTED
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  channel           String
  /// Provider message ID; unique per channel so redelivered messages are ignored.
  externalMessageId String?
  direction         MessageDirection
  type              MessageType
  /// Text as typed, or empty for audio before transcription.
  content           String           @default("")
  /// Raw ASR output for voice notes.
  transcription     String?
  /// BCP-47 tag detected by ASR / language identification.
  detectedLanguage  String?
  /// Text fed to the agent (translated/normalized when applicable).
  normalizedText    String?
  mediaMimeType     String?
  correlationId     String?
  createdAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([channel, externalMessageId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Financial safety: confirmations, audit, webhook idempotency
// ---------------------------------------------------------------------------

enum ConfirmationAction {
  CREATE_PAYMENT_REQUEST
  ADD_SHIPMENT_TRACKING
  SUBMIT_DISPUTE_RESPONSE
  SEND_PAYMENT_REMINDER
  SEND_INVOICE
  REFUND_PAYMENT
}

enum ConfirmationStatus {
  PENDING
  /// Claimed by a confirm reply; execution in progress.
  CONFIRMED
  EXECUTED
  CANCELLED
  EXPIRED
  FAILED
}

/// A sensitive action proposed by the agent, waiting for explicit merchant confirmation.
/// Bound to merchant + conversation + action + exact payload (hash) + expiry.
model ActionConfirmation {
  id             String             @id @default(cuid())
  merchantId     String
  conversationId String
  action         ConfirmationAction
  payload        Json
  /// SHA-256 of the canonical payload; re-checked before execution.
  payloadHash    String
  /// Short code the merchant can quote ("confirm 4821").
  code           String
  /// Deterministic, backend-generated summary shown to the merchant.
  summary        String
  status         ConfirmationStatus @default(PENDING)
  expiresAt      DateTime
  confirmedAt    DateTime?
  executedAt     DateTime?
  result         Json?
  error          String?
  correlationId  String?
  createdAt      DateTime           @default(now())

  merchant     Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@index([merchantId, createdAt])
  @@map("action_confirmations")
}

enum AuditActor {
  AGENT
  MERCHANT
  SYSTEM
  PROVIDER
}

/// Append-only trail of important AI-generated and financial events.
model AuditEvent {
  id            String     @id @default(cuid())
  merchantId    String?
  actor         AuditActor
  /// Dotted event type, e.g. "agent.intent_interpreted", "payment.completed".
  type          String
  entityType    String?
  entityId      String?
  data          Json?
  correlationId String?
  createdAt     DateTime   @default(now())

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([merchantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// Every provider webhook is recorded once (provider + eventId unique) so
/// redelivered events never trigger duplicate side effects.
model WebhookEvent {
  id          String             @id @default(cuid())
  provider    PaymentProvider
  eventId     String
  eventType   String
  status      WebhookEventStatus @default(RECEIVED)
  payload     Json
  error       String?
  receivedAt  DateTime           @default(now())
  /// When processing last started; a RECEIVED event claimed long ago was abandoned and is retried.
  claimedAt   DateTime           @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// ─── Fulfillment ────────────────────────────────────────────────────────────

/// Mirrors PayPal's tracker status (Orders v2 trackers are SHIPPED or CANCELLED; PayPal has no
/// delivered state, so Katale doesn't invent one).
enum ShipmentStatus {
  SHIPPED
  CANCELLED
}

/// A tracking number attached to a paid order. Created only after PayPal accepted the tracker.
model Shipment {
  id                String         @id @default(cuid())
  merchantId        String
  orderId           String
  paymentId         String?
  /// PayPal carrier code (e.g. DHL, UPS, OTHER).
  carrier           String
  /// The merchant's carrier name when carrier = OTHER.
  carrierNameOther  String?
  trackingNumber    String
  status            ShipmentStatus @default(SHIPPED)
  /// PayPal tracker ID (<captureId>-<trackingNumber>).
  providerTrackerId String?
  providerSyncedAt  DateTime?
  shippedAt         DateTime       @default(now())
  correlationId     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([orderId, trackingNumber])
  @@index([merchantId, createdAt])
  @@map("shipments")
}

// ─── Disputes ───────────────────────────────────────────────────────────────

/// A PayPal dispute, synchronised from PayPal (webhook or refresh). Status/reason values are
/// PayPal's own enums, stored as received. Order/payment links are optional: a dispute may not
/// match a Katale payment.
model Dispute {
  id                  String    @id @default(cuid())
  merchantId          String?
  orderId             String?
  paymentId           String?
  paypalDisputeId     String    @unique
  /// e.g. MERCHANDISE_OR_SERVICE_NOT_RECEIVED
  reason              String
  /// OPEN | WAITING_FOR_BUYER_RESPONSE | WAITING_FOR_SELLER_RESPONSE | UNDER_REVIEW | RESOLVED | OTHER
  status              String
  /// INQUIRY | CHARGEBACK | PRE_ARBITRATION | ARBITRATION
  lifecycleStage      String?
  /// PayPal's outcome code once resolved (e.g. RESOLVED_SELLER_FAVOUR)
  outcome             String?
  amountMinor         Int?
  currency            String?
  /// Capture ID PayPal reports as the disputed seller transaction.
  sellerTransactionId String?
  buyerMessage        String?
  sellerResponseDueAt DateTime?
  openedAt            DateTime?
  providerUpdatedAt   DateTime?
  /// Last status the merchant was told about (avoids repeated WhatsApp notifications).
  notifiedStatus      String?
  /// Canonical dispute details from GET /v1/customer/disputes/{id} (not shown by default).
  providerData        Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  merchant  Merchant?         @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment   Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  responses DisputeResponse[]

  @@index([merchantId, status])
  @@map("disputes")
}

/// A merchant-approved response submitted to PayPal (one per SUBMIT confirmation).
model DisputeResponse {
  id             String    @id @default(cuid())
  disputeId      String
  merchantId     String
  confirmationId String    @unique
  responseText   String
  /// Evidence sent: [{ type, label, detail }]
  evidence       Json
  status         String
  error          String?
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@map("dispute_responses")
}

// ─── Inventory ──────────────────────────────────────────────────────────────

enum StockMovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
  DAMAGED
}

/// Append-only stock ledger: every change to Product.stockQuantity, with the balance after it.
model StockMovement {
  id            String            @id @default(cuid())
  merchantId    String
  productId     String
  type          StockMovementType
  /// Signed change in units (sales are negative).
  quantity      Int
  balanceAfter  Int
  orderId       String?
  note          String?
  actor         AuditActor
  correlationId String?
  createdAt     DateTime          @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// One SALE movement per order line: a paid order never reduces stock twice.
  @@unique([orderId, productId, type])
  @@index([merchantId, createdAt])
  @@index([productId, createdAt])
  @@map("stock_movements")
}

// ─── Proactive reports ──────────────────────────────────────────────────────

enum ReportFrequency {
  DAILY
  WEEKLY
  /// On the 1st of each month, covering the previous calendar month.
  MONTHLY
}

/// When and what the business report contains. One per merchant.
model ReportSchedule {
  id               String          @id @default(cuid())
  merchantId       String          @unique
  enabled          Boolean         @default(false)
  frequency        ReportFrequency @default(WEEKLY)
  /// 1 = Monday … 7 = Sunday (weekly reports).
  weekday          Int             @default(1)
  hour             Int             @default(8)
  minute           Int             @default(0)
  /// IANA time zone; null = the merchant's.
  timezone         String?
  includeSales     Boolean         @default(true)
  includeInventory Boolean         @default(true)
  includeUnpaid    Boolean         @default(true)
  includeDisputes  Boolean         @default(true)
  includeChart     Boolean         @default(true)
  includeInsights  Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("report_schedules")
}

enum ReportRunStatus {
  SENDING
  SENT
  PARTIAL
  FAILED
}

/// One generated report. (merchant, periodKey) is unique, so a slot is never reported twice.
model ReportRun {
  id           String          @id @default(cuid())
  merchantId   String
  /// e.g. "WEEKLY:2026-10-19" (scheduled slot, local date) or "MANUAL:<timestamp>".
  periodKey    String
  trigger      String
  scheduledFor DateTime
  status       ReportRunStatus @default(SENDING)
  text         String
  /// The chart image (base64 PNG), kept so retries send the same report.
  chartBase64  String?
  chartCaption String?
  createdAt    DateTime        @default(now())
  completedAt  DateTime?

  merchant   Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  deliveries ReportDelivery[]

  @@unique([merchantId, periodKey])
  @@index([merchantId, createdAt])
  @@map("report_runs")
}

enum ReportDeliveryStatus {
  PENDING
  SENT
  FAILED
}

/// Delivery of one report to one admin, with retries. Text and chart are tracked separately so a
/// retry never repeats the part that already arrived.
model ReportDelivery {
  id            String               @id @default(cuid())
  runId         String
  operatorId    String
  chatId        String
  status        ReportDeliveryStatus @default(PENDING)
  attempts      Int                  @default(0)
  lastError     String?
  textSentAt    DateTime?
  chartSentAt   DateTime?
  sentAt        DateTime?
  nextAttemptAt DateTime             @default(now())
  createdAt     DateTime             @default(now())

  run      ReportRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  operator MerchantOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@unique([runId, operatorId])
  @@index([status, nextAttemptAt])
  @@map("report_deliveries")
}

/// One photo per product, uploaded in the dashboard and sent in WhatsApp product browsing.
/// Stored in Postgres (small JPEG/PNG, ≤ 1 MB) so no extra storage service is needed.
/// Where a product photo's bytes live.
enum ImageStorage {
  /// In this table (`data` / `thumbData`): no object storage configured.
  DATABASE
  /// In the Cloudflare R2 bucket under `objectKey` / `thumbKey` (private; served through the API).
  R2
}

/// One photo per product: a resized main image (JPEG, ≤1600 px) and a 320 px thumbnail.
model ProductImage {
  id        String       @id @default(cuid())
  productId String       @unique
  mimeType  String
  storage   ImageStorage @default(DATABASE)
  /// DATABASE storage: the main image and thumbnail bytes.
  data      Bytes?
  thumbData Bytes?
  /// R2 storage: object keys (merchants/<merchant>/products/<product>/<uuid>[-thumb].jpg).
  objectKey String?
  thumbKey  String?
  sizeBytes Int
  width     Int?
  height    Int?
  updatedAt DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

/// Who approves generated WhatsApp Status adverts before they are ready to post.
enum StatusAdApproval {
  /// Drafts wait for an admin to review and approve them.
  MANUAL
  /// Generated adverts are ready to post straight away.
  AUTO
}

/// Who posts an advert once it is ready.
enum StatusAdPublish {
  /// The merchant downloads it and posts it from their phone.
  PHONE
  /// Katale posts it to the connected shop number's Status (STATUS_ADS_POSTING_ENABLED).
  KATALE
}

/// WhatsApp Status adverts: Katale prepares them; the merchant posts them from their phone, or
/// Katale posts them through the WhatsApp worker. See docs/architecture/whatsapp-status-marketing.md.
model StatusAdSettings {
  id         String           @id @default(cuid())
  merchantId String           @unique
  enabled    Boolean          @default(false)
  /// ISO weekdays to prepare adverts on: 1 = Monday … 7 = Sunday.
  weekdays   Int[]            @default([1, 2, 3, 4, 5, 6, 7])
  /// Local times ("HH:MM", at most 3) at which an advert is prepared.
  times      String[]         @default(["09:00"])
  /// IANA time zone; null = the merchant's.
  timezone   String?
  approval   StatusAdApproval @default(MANUAL)
  publish    StatusAdPublish  @default(PHONE)
  /// Products to promote; empty = every eligible product.
  productIds String[]         @default([])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("status_ad_settings")
}

enum StatusAdStatus {
  /// Waiting for an admin to approve.
  DRAFT
  /// Approved (or auto-approved): ready to download and post, or for Katale to post.
  READY
  /// Posted on WhatsApp (by the merchant, or by Katale).
  POSTED
  /// Dismissed by an admin.
  SKIPPED
  /// Could not be prepared (e.g. no eligible product); retried automatically, then manually.
  FAILED
}

model StatusAd {
  id              String         @id @default(cuid())
  merchantId      String
  productId       String?
  /// e.g. "SLOT:2026-11-01T09:00" (scheduled, local time) or "MANUAL:<timestamp>": unique per
  /// merchant, so a slot is never prepared twice.
  slotKey         String
  trigger         String
  scheduledFor    DateTime
  status          StatusAdStatus @default(DRAFT)
  headline        String         @default("")
  caption         String         @default("")
  cta             String         @default("")
  /// Colour theme index used for the image.
  theme           Int            @default(0)
  /// "ai" or "template" (where the wording came from); "edited" once an admin changed it.
  source          String         @default("template")
  attempts        Int            @default(0)
  lastError       String?
  nextAttemptAt   DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  postedAt        DateTime?
  postedBy        String?
  /// "phone" (the merchant posted it) or "katale" (posted through the WhatsApp worker).
  postedVia       String?
  /// Set while Katale is posting it: a claim, so two ticks or instances never post it twice.
  publishingAt    DateTime?
  /// Katale's posting attempts; failures leave the advert READY for the phone.
  publishAttempts Int            @default(0)
  publishError    String?
  nextPublishAt   DateTime?
  /// WhatsApp's ID for the posted Status (Katale posts only).
  statusMessageId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([merchantId, slotKey])
  @@index([merchantId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("status_ads")
}

// ---------------------------------------------------------------------------
// Public storefront
// ---------------------------------------------------------------------------

/// A merchant's public web catalogue at /shop/<slug>. Its own table so logo bytes are never loaded
/// with the Merchant row, which is read on every inbound message.
model Storefront {
  merchantId    String        @id
  slug          String        @unique
  /// Nothing is public until the owner publishes.
  enabled       Boolean       @default(false)
  tagline       String?
  about         String?
  logoMimeType  String?
  logoStorage   ImageStorage?
  /// DATABASE storage: logo bytes. R2 storage: object key.
  logoData      Bytes?
  logoKey       String?
  logoUpdatedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("storefronts")
}

enum CartTransferStatus {
  /// Waiting for the customer's WhatsApp message.
  OPEN
  /// Received on WhatsApp and moved into that customer's cart. Single use.
  CLAIMED
  /// Replaced by a newer checkout from the same browser cart.
  SUPERSEDED
}

/// A web cart on its way to WhatsApp. Website carts live in the browser; this row exists only from
/// "Checkout on WhatsApp" until the reference is used or expires. The reference itself is never
/// stored, only its hash. Items are quantities plus the price the customer saw (for a "price
/// changed" note): every price is recalculated from the catalogue when the cart is claimed.
model CartTransfer {
  id         String             @id @default(cuid())
  merchantId String
  tokenHash  String             @unique
  /// Random ID of the browser's cart: a newer checkout replaces the older reference.
  clientKey  String?
  status     CartTransferStatus @default(OPEN)
  /// [{ productId, name, quantity, seenUnitMinor }]
  items      Json
  expiresAt  DateTime
  customerId String?
  orderId    String?
  claimedAt  DateTime?
  createdAt  DateTime           @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, clientKey, status])
  @@index([expiresAt])
  @@map("cart_transfers")
}

/// A dashboard person's saved Overview: an AG Studio report state. Removing it restores the default.
model DashboardLayout {
  id         String   @id @default(cuid())
  merchantId String
  /// DashboardUser id, or "bootstrap" for the setup login.
  userKey    String
  state      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userKey])
  @@map("dashboard_layouts")
}
